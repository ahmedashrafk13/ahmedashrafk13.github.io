   "parameters": {
    "jsCode": "return items.map(item => {\n  const regex = /<a href=\"([^\"]+)\".*?>(.*?)<\\/a>.*?<font.*?>(.*?)<\\/font>/;\n  const match = regex.exec(item.json.content || \"\");\n  \n  return {\n    json: {\n      title: match ? match[2] : item.json.contentSnippet,\n      link: match ? match[1] : null,\n      source: match ? match[3] : \"Unknown\",\n      date: item.json.pubDate,\n      snippet: item.json.contentSnippet\n    }\n  }\n});\n"
   },
