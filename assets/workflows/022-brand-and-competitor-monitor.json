   "name": "Remove Duplicates"
  },
  {
   "parameters": {
    "jsCode": "return items.map(item => {\n  const text = (item.json.title + \" \" + item.json.snippet).toLowerCase();\n  let priority = \"Low\";\n\n  if (text.includes(\"lawsuit\") || text.includes(\"funding\") || text.includes(\"ceo\") || text.includes(\"gpt-5\")) {\n    priority = \"High\";\n  } else if (text.includes(\"gpt-6\") || text.includes(\"partnership\") || text.includes(\"research\")) {\n    priority = \"Medium\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      priority\n    }\n  };\n});\n"
   },
