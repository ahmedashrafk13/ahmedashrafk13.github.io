  {
   "parameters": {
    "jsCode": "// Loop over each incoming item and return a cleaned version\nreturn items.map(entry => {\n  const raw = entry.json.data || \"\";\n\n  // Remove the \"Title:\", \"URL Source:\", and \"Published Time:\" sections\n  let cleaned = raw\n    .replace(/Title:.*?\\n\\n/s, \"\")\n    .replace(/URL Source:.*?\\n\\n/s, \"\")\n    .replace(/Published Time:.*?\\n\\n/s, \"\");\n\n  // Remove image markdown: ![...](...)\n  cleaned = cleaned.replace(/!\\[.*?\\]\\(.*?\\)/g, \"\");\n\n  // Remove \"Markdown Content:\" label if present\n  cleaned = cleaned.replace(/Markdown Content:\\s*/i, \"\");\n\n  // Remove extra newlines\n  cleaned = cleaned.replace(/\\n{2,}/g, \"\\n\\n\").trim();\n\n  return {\n    json: {\n      articleBody: cleaned\n    }\n  };\n});\n"
   },
