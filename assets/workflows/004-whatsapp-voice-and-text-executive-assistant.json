  {
   "parameters": {
    "jsCode": "const output = $input.first().json.output;\n\nconsole.log(output);\n\nconst results = [];\n\n// Split the output into blocks (separated by double newlines)\nconst emailBlocks = output\n  .split(`\\n\\n`)\n  .filter(block => block.includes('**Email**') && block.includes('**MessageID**'));\n\nfor (const block of emailBlocks) {\n  // Extract name from the markdown header, like **[LinkedIn Job Alerts]**\n  const nameMatch = block.match(/\\*\\*\\[(.*?)\\]\\*\\*/);\n  const emailMatch = block.match(/\\*\\*Email\\*\\*: ([^\\n]+)/);\n  const messageIdMatch = block.match(/\\*\\*MessageID\\*\\*: ([^\\n]+)/);  // Accepts alphanumeric\n\n  if (nameMatch && emailMatch && messageIdMatch) {\n    results.push({\n      Name: nameMatch[1],\n      Email: emailMatch[1].trim(),\n      MessageID: messageIdMatch[1].trim()\n    });\n  }\n}\n\nreturn results;\n"
   },
