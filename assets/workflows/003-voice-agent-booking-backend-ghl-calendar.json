    "name": "getTimezone",
    "description": "Call this tool to get the current timezone's latest time. ",
    "jsCode": "const timezone = query.timezone\n\nconst now = new Date();\n\nconst options = { timeZone: timezone, hour12: false };\nconst formatterDate = new Intl.DateTimeFormat('en-US', { ...options, year: 'numeric', month: '2-digit', day: '2-digit' });\nconst formatterTime = new Intl.DateTimeFormat('en-US', { ...options, hour: '2-digit', minute: '2-digit', second: '2-digit' });\nconst formatterDay = new Intl.DateTimeFormat('en-US', { ...options, weekday: 'long' });\n\nconst dateParts = formatterDate.formatToParts(now).reduce((acc, part) => {\n  if (part.type !== 'literal') acc[part.type] = part.value;\n  return acc;\n}, {});\n\nconst timeParts = formatterTime.formatToParts(now).reduce((acc, part) => {\n  if (part.type !== 'literal') acc[part.type] = part.value;\n  return acc;\n}, {});\n\nconst dayOfWeek = formatterDay.format(now);\n\nconst output = {\n  year: parseInt(dateParts.year),\n  month: parseInt(dateParts.month),\n  day: parseInt(dateParts.day),\n  hour: parseInt(timeParts.hour),\n  minute: parseInt(timeParts.minute),\n  seconds: parseInt(timeParts.second),\n  milliSeconds: now.getMilliseconds(),\n  dateTime: now.toISOString(),\n  date: `${dateParts.month}/${dateParts.day}/${dateParts.year}`,\n  time: `${timeParts.hour}:${timeParts.minute}`,\n  timeZone: timezone,\n  dayOfWeek: dayOfWeek,\n  dstActive: false\n};\n\nreturn JSON.stringify(output);",
    "specifyInputSchema": true,
    "schemaType": "manual",
    "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"timezone\": {\n      \"type\": \"string\",\n      \"description\": \"The user's timezone in format like 'Asia/Kolkata' or 'America/New_York'.\"\n    }\n  },\n  \"required\": [\"timezone\"]\n}"
   },
